# .env is gitignored — never commit real values.

# --- backend/.env — copy this file there and fill in ---
#
# Optional. Without it the witch still brews, using the deterministic
# generator; set it to get Claude-written potions.
# Get a key: https://platform.claude.com/dashboard
ANTHROPIC_API_KEY=your-key-here

# --- repo root .env — read by dev-loop.js (dotenv.config()) ---
#
# All optional. Without them, `npm run dev-loop` still runs end to end: no
# Figma URL means the orchestrator plans from the PRD alone, and no Linear
# key means tickets are simulated and the loop asks for a terminal APPROVED
# instead of watching a Linear ticket move to Done.

# Figma frame URL for the orchestrator to inspect during planning.
FIGMA_URL=

# Linear API key (Settings -> API -> Personal API keys). Starts with lin_api_
LINEAR_API_KEY=

# Linear team UUID that FE/BE/QA tickets are created under.
LINEAR_TEAM_ID=
