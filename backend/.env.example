# backend/.env — copy to backend/.env and fill in. Never commit real values.

# Optional. Without it the witch still brews, using the offline generator; set
# it to get Claude-written potions (the witch generator, a later task). It is
# read only here, never returned in a response, and never logged.
ANTHROPIC_API_KEY=your-key-here

# Port the Node service listens on. Defaults to 8787 when unset — 5173 and its
# neighbours are often taken on this shared machine.
PORT=8787

# The single origin CORS allows (the frontend). In dev the browser reaches the
# service same-origin through Vite's /api proxy, so this only matters for
# non-proxied use.
FRONTEND_URL=http://localhost:5173
