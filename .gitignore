# Secrets — never commit. See .env.example for the shape.
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Dev loop output — regenerated every run, never source of truth. The README
# that explains the directory stays tracked. See .orchestrate/README.md.
.orchestrate/*
!.orchestrate/README.md
